# ── API de lenguaje (Groq) ──────────────────────────────────
GROQ_API_KEY=tu_clave_de_groq_aqui
 
# ── Entorno de ejecución ────────────────────────────────────
APP_ENV=production
 
# ── Puerto del servidor ─────────────────────────────────────
API_PORT=8000